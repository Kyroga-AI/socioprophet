rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Minimal baseline: users can access only their own user document.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }


    // ---- NEXT COLLECTIONS (intentionally disabled until predicates are defined) ----
    // match /jobs/{jobId} {
    //   allow read: if false;
    //   allow write: if false;
    // }

    // Default: deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
